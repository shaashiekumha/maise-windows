<Window x:Class="Maise.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Maise for Windows — Neural Speech Engine" 
        Height="680" Width="920"
        MinHeight="550" MinWidth="750"
        Background="#0F172A"
        Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="64"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MAISE" FontSize="20" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                    <TextBlock Text="for Windows" FontSize="14" Foreground="#94A3B8" Margin="8,4,0,0" VerticalAlignment="Center"/>
                    <Border Background="#065F46" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ONNX CPU (AVX)" FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ServerStatusPill" Background="#334155" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" Fill="#94A3B8" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ServerStatusText" Text="API: Stopped" FontSize="12" Foreground="#E2E8F0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab Content -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="16,10,16,10">
            <!-- TAB 1: TEXT TO SPEECH -->
            <TabItem Header="🗣️ Text-to-Speech (Kokoro)">
                <Grid Margin="10,16,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Voice Controls Bar -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Voice Selection:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox x:Name="VoiceComboBox" Height="32" Background="#0F172A" Foreground="#000000" BorderBrush="#475569"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <Grid>
                                    <TextBlock Text="Speed (Rate):" FontSize="12" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="SpeedLabel" Text="1.0x" FontSize="12" Foreground="#60A5FA" HorizontalAlignment="Right"/>
                                </Grid>
                                <Slider x:Name="SpeedSlider" Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="SpeedSlider_ValueChanged" Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button x:Name="SpeakButton" Content="▶ Speak Aloud" Click="SpeakButton_Click" Background="#2563EB" Margin="0,0,8,0"/>
                                <Button x:Name="StopButton" Content="⏹ Stop" Click="StopButton_Click" Background="#DC2626" Margin="0,0,8,0"/>
                                <Button x:Name="SaveWavButton" Content="💾 Save WAV..." Click="SaveWavButton_Click" Background="#475569"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Text Area -->
                    <TextBox x:Name="TtsInputText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Text="Welcome to Maise for Windows! This is high quality neural text-to-speech powered by the Kokoro model, running completely offline and on-device on your CPU."/>

                    <!-- Streaming info -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Background="#1E293B" CornerRadius="6" Padding="10" BorderBrush="#334155" BorderThickness="1">
                        <TextBlock x:Name="TtsStatusDetails" Text="Ready to synthesize 24 kHz high-fidelity audio." FontSize="12" Foreground="#94A3B8"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: SPEECH TO TEXT -->
            <TabItem Header="🎙️ Speech-to-Text (Distil-Whisper)">
                <Grid Margin="10,16,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Recording Controls -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="RecordButton" Content="🔴 Hold / Click to Record" Click="RecordButton_Click" Background="#DC2626" Width="180" Margin="0,0,16,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Microphone Audio Level:" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ProgressBar x:Name="AudioLevelBar" Height="10" Minimum="0" Maximum="1" Value="0" Foreground="#10B981" Background="#0F172A" BorderThickness="0"/>
                            </StackPanel>

                            <Button x:Name="TranscribeFileButton" Grid.Column="2" Content="📁 Transcribe WAV File..." Click="TranscribeFileButton_Click" Background="#475569"/>
                        </Grid>
                    </Border>

                    <!-- Transcript Box -->
                    <TextBox x:Name="AsrOutputText" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="False"/>

                    <!-- Transcript Actions -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="AsrStatusDetails" Text="Click record to speak or load a 16 kHz audio file to transcribe." FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="📋 Copy Transcript" Click="CopyTranscriptButton_Click" Background="#475569"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 3: LOCAL API SERVER -->
            <TabItem Header="🌐 Local API Server">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,16,10,0">
                    <StackPanel>
                        <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="OpenAI-Compatible Local REST Server" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                                    <TextBlock Text="Runs a local speech API on localhost so third-party apps, browser extensions, and AI tools can access on-device Kokoro TTS &amp; Whisper STT." FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button x:Name="ToggleServerButton" Grid.Column="1" Content="Start API Server" Click="ToggleServerButton_Click" Background="#10B981" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Available Endpoints" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                                <TextBlock Text="• POST /v1/audio/speech — Synthesize text to WAV audio" FontFamily="Consolas" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="• POST /v1/audio/transcriptions — Transcribe uploaded WAV audio to text" FontFamily="Consolas" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="• GET  /v1/audio/voices — List all available voices and metadata" FontFamily="Consolas" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="• GET  /health — Engine status and CPU health" FontFamily="Consolas" Foreground="#60A5FA"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Sample cURL Test (TTS):" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,6"/>
                                <TextBox Text="curl http://127.0.0.1:8033/v1/audio/speech -H &quot;Content-Type: application/json&quot; -d &quot;{\&quot;input\&quot;:\&quot;Hello from Maise\&quot;,\&quot;voice\&quot;:\&quot;en-US-heart-kokoro\&quot;}&quot; --output test.wav" IsReadOnly="True" FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: HOTKEYS & SETTINGS -->
            <TabItem Header="⚙️ System Hotkeys &amp; Tray">
                <StackPanel Margin="10,16,10,0">
                    <Border Background="#1E293B" CornerRadius="8" Padding="16" Margin="0,0,0,14" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Global Windows Shortcuts" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#334155" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Win + Alt + S" FontFamily="Consolas" FontWeight="Bold" Foreground="#60A5FA"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Speak Clipboard / Highlighted text in any Windows app" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#334155" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="Win + Alt + D" FontFamily="Consolas" FontWeight="Bold" Foreground="#34D399"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="Push-to-Talk Speech Dictation (Transcribes microphone audio directly)" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="14,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E293B" CornerRadius="8" Padding="16" BorderBrush="#334155" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Application Behavior" FontSize="14" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,0,0,10"/>
                            <CheckBox x:Name="MinimizeToTrayCheckBox" Content="Minimize to System Tray on close" IsChecked="True" Foreground="#F8FAFC"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="GlobalStatusText" Text="Maise Engine Ready" FontSize="12" Foreground="#94A3B8"/>
                <TextBlock Text="Maise v1.0.0 (Ported to Windows)" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
